# ============================================================
# RentInAlvin.com Environment Variables
# Copy this file to .env.local and fill in your real values.
# ============================================================

# -----------------------------------------------------------
# Site (required)
# -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://rentinalvin.com"

# Optional: external application URL (e.g., AppFolio, RentManager)
# If set, the Apply button will link here instead of the internal form.
# NEXT_PUBLIC_APPLICATION_URL=""

# -----------------------------------------------------------
# Database (required for saving leads/applications/tours)
# Uses SQLite by default for local dev. Replace with PostgreSQL
# or MySQL URL for production (e.g., Neon, Supabase, Railway).
# -----------------------------------------------------------
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------
# Email (Resend — recommended)
# Get your API key at https://resend.com
# -----------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Yellowstone Asset Management <office@yellowstone-am.com>"

# Recipient addresses for lead notifications.
# Comma-separated for multiple recipients.
LEADS_TO_EMAIL="office@yellowstone-am.com"

# -----------------------------------------------------------
# Google Service Account (required for Sheets + Calendar)
# Create a service account in Google Cloud Console,
# download the JSON key, and share your Sheet/Calendar
# with the service account email.
# -----------------------------------------------------------
GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_CALENDAR_ID="primary"

# -----------------------------------------------------------
# Map (optional — if you want to switch from OpenStreetMap)
# The site works without these; OpenStreetMap is the default.
# -----------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# NEXT_PUBLIC_MAPBOX_TOKEN=""

# -----------------------------------------------------------
# Internal API protection (optional)
# Use if you add internal/admin routes later.
# -----------------------------------------------------------
# INTERNAL_API_KEY=""
