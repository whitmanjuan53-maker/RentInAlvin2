# ============================================================
# RentInAlvin.com Environment Variables
# Copy this file to .env.local and fill in your real values.
# ============================================================

# -----------------------------------------------------------
# Site (required)
# -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://rentinalvin.com"

# Optional: external application URL (e.g., AppFolio, RentManager)
# If set, the Apply button will link here instead of the internal form.
# NEXT_PUBLIC_APPLICATION_URL=""

# -----------------------------------------------------------
# Database (required for saving leads/applications/tours)
# Uses SQLite by default for local dev. Replace with PostgreSQL
# or MySQL URL for production (e.g., Neon, Supabase, Railway).
# -----------------------------------------------------------
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------
# Email
# The backend supports SMTP, SendGrid, and Resend.
# You only need ONE provider configured to send real emails.
#
# --- FASTEST FREE OPTION: Gmail SMTP ---
# If you have a Gmail or Google Workspace account, this works in 2 minutes.
# 1. Enable 2-Step Verification on the Google account.
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password (select "Mail" + "Other").
# 4. Paste the 16-character password below as SMTP_PASS.
# 5. Set EMAIL_FROM to the same Gmail address.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="youremail@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
#
# --- Other free SMTP providers ---
# Zoho Mail Free:  SMTP_HOST=smtp.zoho.com, PORT=587
# Brevo (Sendinblue) Free: 300 emails/day — get SMTP creds in their dashboard
# Your hosting cPanel: use the SMTP creds from your hosting provider
#
# --- API-based options ---
# SendGrid: free 100 emails/day. Sign up, create API key, paste it.
# SENDGRID_API_KEY="SG.xxxxxxxx"
#
# Resend: free 100 emails/day. Requires domain verification first.
# RESEND_API_KEY="re_xxxxxxxx"
# -----------------------------------------------------------

# Sender email — all form notifications sent from this address.
# If using Gmail SMTP, this must match your SMTP_USER address.
EMAIL_FROM="no-reply@rentinalvin.com"

# Primary recipient for lead notifications.
EMAIL_TO="office@yellowstone-am.com"

# CC recipients — all employee emails that should receive notifications.
# Comma-separated, no spaces.
EMAIL_CC="manager@yellowstone-am.com,dor@yellowstone-am.com,lise@yellowstone-am.com,zoe@yellowstone-am.com"

# Reply-To is dynamically set to the customer's email from the form.
# When the team clicks Reply, it goes directly to the customer.
# Do NOT set a static EMAIL_REPLY_TO env var — the backend handles it.

# -----------------------------------------------------------
# Google Service Account (required for Sheets + Calendar)
# Create a service account in Google Cloud Console,
# download the JSON key, and share your Sheet/Calendar
# with the service account email.
# -----------------------------------------------------------
GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_CALENDAR_ID="primary"

# -----------------------------------------------------------
# Map (optional — if you want to switch from OpenStreetMap)
# The site works without these; OpenStreetMap is the default.
# -----------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# NEXT_PUBLIC_MAPBOX_TOKEN=""

# -----------------------------------------------------------
# Internal API protection (optional)
# Use if you add internal/admin routes later.
# -----------------------------------------------------------
# INTERNAL_API_KEY=""
